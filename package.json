{
  "name": "@technowobble/loopia-provider",
  "version": "1.0.0",
  "description": "Unofficial Pulumi dynamic provider for Loopia DNS zone records (XML-RPC API)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "pulumi",
    "loopia",
    "dns"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atti187/loopia-provider.git"
  },
